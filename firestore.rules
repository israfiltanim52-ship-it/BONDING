rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function founderUid() {
      return exists(/databases/$(database)/documents/system/adminConfig)
        ? get(/databases/$(database)/documents/system/adminConfig).data.superAdminUid : '';
    }
    function isSuperAdmin() { return signedIn() && founderUid() == request.auth.uid; }
    function hasRole(role) {
      return signedIn() && exists(/databases/$(database)/documents/adminRoles/$(request.auth.uid))
        && get(/databases/$(database)/documents/adminRoles/$(request.auth.uid)).data.role == role;
    }
    function isAdmin() { return isSuperAdmin() || hasRole('admin'); }
    function canModeratePosts() { return isAdmin() || hasRole('moderator'); }
    function canReviewVerification() { return isAdmin() || hasRole('verificationManager'); }
    function isChatMember(chatId) {
      return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Founder configuration is created/updated only in Firebase Console by the project owner.
    match /system/{documentId} {
      allow read: if signedIn() && documentId == 'adminConfig';
      allow write: if false;
    }

    match /adminRoles/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create, update: if isSuperAdmin()
        && userId != request.auth.uid
        && request.resource.data.uid == userId
        && request.resource.data.role in ['admin','moderator','verificationManager'];
      allow delete: if isSuperAdmin() && userId != request.auth.uid;
    }

    match /adminLogs/{logId} {
      allow create: if signedIn() && (isSuperAdmin() || hasRole('admin') || hasRole('moderator') || hasRole('verificationManager'))
        && request.resource.data.actorUid == request.auth.uid;
      allow read: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.keys().hasOnly(['uid','name','email','bio','photoURL','coverURL','verified','createdAt','updatedAt'])
        && (!('verified' in request.resource.data) || request.resource.data.verified == false);
      allow update: if (signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','email','bio','photoURL','coverURL','updatedAt']))
        || (signedIn() && canReviewVerification() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verified','updatedAt'])
        && request.resource.data.verified == true);
      allow delete: if false;
    }

    match /friendRequests/{requestId} {
      allow read: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['fromUid','fromName','toUid','toName','status','createdAt']);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','respondedAt'])
        && request.resource.data.status in ['accepted','rejected'];
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /verificationRequests/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || canReviewVerification());
      allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['uid','name','email','status','createdAt']);
      allow update: if (signedIn() && request.auth.uid == userId && resource.data.status == 'rejected'
        && request.resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','createdAt']))
        || (signedIn() && canReviewVerification() && request.resource.data.uid == resource.data.uid
        && request.resource.data.status in ['approved','rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','reviewedBy','reviewedAt']));
      allow delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string && request.resource.data.text is string
        && request.resource.data.text.size() <= 3000
        && (request.resource.data.text.size() > 0 || ('imageURL' in request.resource.data && request.resource.data.imageURL is string))
        && request.resource.data.keys().hasOnly(['authorId','authorName','text','imageURL','createdAt']);
      allow update: if false;
      allow delete: if signedIn() && (resource.data.authorId == request.auth.uid || canModeratePosts());
      match /reactions/{userId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.auth.uid == userId && request.resource.data.uid == userId && request.resource.data.type == 'like';
        allow update: if false;
        allow delete: if signedIn() && (request.auth.uid == userId || canModeratePosts());
      }
      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.authorName is string && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.keys().hasOnly(['uid','authorName','text','createdAt']);
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || canModeratePosts());
      }
    }

    // Stories are visible to every authenticated BONDING user. Owners alone can delete them.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && (!('imageURL' in request.resource.data) || request.resource.data.imageURL is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(['uid','name','photoURL','text','imageURL','createdAt','expiresAt']);
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      match /viewers/{viewerUid} {
        allow create: if signedIn() && request.auth.uid == viewerUid
          && viewerUid != get(/databases/$(database)/documents/stories/$(storyId)).data.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.viewedAt is timestamp
          && request.resource.data.keys().hasOnly(['uid','name','viewedAt']);
        allow read: if signedIn()
          && get(/databases/$(database)/documents/stories/$(storyId)).data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /chats/{chatId} {
      allow create: if signedIn() && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.keys().hasOnly(['members','updatedAt','lastMessage']);
      allow read: if isChatMember(chatId);
      allow update: if isChatMember(chatId) && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);
        allow create: if isChatMember(chatId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000
          && (request.resource.data.text.size() > 0 || ('mediaUrl' in request.resource.data && request.resource.data.mediaUrl is string))
          && request.resource.data.keys().hasOnly(['senderId','senderName','text','mediaUrl','mediaType','createdAt'])
          && (!('mediaType' in request.resource.data) || request.resource.data.mediaType in ['image','video']);
        // Only the other chat member may add delivery/read timestamps; message content stays immutable.
        allow update: if isChatMember(chatId)
          && request.auth.uid != resource.data.senderId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveredAt','readAt'])
          && (!('deliveredAt' in request.resource.data) || request.resource.data.deliveredAt is timestamp)
          && (!('readAt' in request.resource.data) || request.resource.data.readAt is timestamp);
        allow delete: if false;
      }
    }
  }
}
